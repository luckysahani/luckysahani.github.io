---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Monogram from '../components/Monogram.astro';
import portrait from '../assets/profile.jpg';
import { places, trips } from '../data/travel';
import { stats as gameStats } from '../data/gaming';
import { systems } from '../data/career';
import { chinese, japanese } from '../data/anime';

// Every figure is derived from the data the pages themselves render, so the
// front page cannot drift out of step with what it links to.
const animeCount = chinese.length + japanese.length;
const nextTrip = trips.find((t) => t.status === 'ahead');

const WEDDING = '2026-11-21';
const daysTo = Math.max(
  0,
  Math.round((Date.parse(WEDDING) - Date.parse(new Date().toISOString().slice(0, 10))) / 86400000),
);

const now = [
  { k: 'Wedding', v: `${daysTo} days`, id: 'wed-count' },
  { k: 'Next trip', v: nextTrip ? `${nextTrip.place}, ${nextTrip.when.replace(/^Late /, '')}` : '—' },
  { k: 'Home since', v: 'July 2026' },
];

const sections = [
  { href: '/career/',  label: 'Career',  stat: '10 yrs', unit: 'at Amazon',
    line: `Ten years of platforms. ${systems.length} systems, drawn rather than described.` },
  { href: '/travel/',  label: 'Travel',  stat: String(places.length), unit: 'places',
    line: 'India and the United States, and what is still ahead.' },
  { href: '/gaming/',  label: 'Gaming',  stat: gameStats.hours.toLocaleString(), unit: 'hours',
    line: 'Thirteen years on Steam, and one game with most of them.' },
  { href: '/anime/',   label: 'Anime',   stat: String(animeCount), unit: 'ranked',
    line: 'Chinese and Japanese, ten of each, by world rating.' },
  { href: '/wedding/', label: 'Wedding', stat: '21 Nov', unit: '2026',
    line: 'Schedule, venue, and how to get there.' },
];
---

<Base
  title="Lucky Sahani"
  description="Engineer in Gurgaon. Ten years at Amazon, most of them in Seattle. Lists of games, places and anime, and the work behind them."
  bare
>
  <div class="home">
    <section class="hero">
      <p class="eyebrow reveal" style="--d:0ms">Gurgaon, India</p>

      <h1 class="name reveal" style="--d:60ms">Lucky<br />Sahani</h1>

      <figure class="portrait reveal" style="--d:220ms">
        <Image src={portrait} alt="Lucky Sahani on a trek, in front of a waterfall"
               widths={[320, 520, 720]} sizes="(max-width: 820px) 60vw, 22vw" loading="eager" />
      </figure>

      <div class="intro reveal" style="--d:140ms">
        <p class="lede">
          Engineer. Ten years at Amazon, most of them in Seattle — home again
          now, and getting married in November.
        </p>
        <p>
          I keep lists. Games I fully intend to get to, places I have been,
          anime I am several seasons behind on. This site is mostly those
          lists, and the work that paid for them.
        </p>
      </div>
    </section>

    <dl class="now reveal" style="--d:300ms">
      {now.map((n) => (
        <div>
          <dt>{n.k}</dt>
          <dd id={n.id}>{n.v}</dd>
        </div>
      ))}
      <div class="now-mark"><Monogram size={20} /></div>
    </dl>

    <nav class="index" aria-label="Sections">
      {sections.map((s, i) => (
        <a class="card reveal" style={`--d:${340 + i * 60}ms`} href={s.href}>
          <span class="card-label">{s.label}</span>
          <span class="card-stat tabular">
            {s.stat}<span class="card-unit">{s.unit}</span>
          </span>
          <span class="card-line">{s.line}</span>
          <span class="card-go" aria-hidden="true">→</span>
        </a>
      ))}
    </nav>
  </div>
</Base>

<script is:inline define:vars={{ WEDDING }}>
  // Rendered server-side too, so this only corrects for days elapsed since
  // the last build rather than being the only source of the number.
  (function () {
    var el = document.getElementById('wed-count');
    if (!el) return;
    var today = new Date();
    var d = Math.round(
      (Date.parse(WEDDING) - Date.parse(today.toISOString().slice(0, 10))) / 86400000,
    );
    if (d > 0) el.textContent = d + ' days';
    else if (d === 0) el.textContent = 'today';
    else el.textContent = 'married';
  })();
</script>

<style>
  .home { max-width: 78rem; margin: 0 auto; padding: 0 1.5rem 2.5rem; }

  /* ---- entrance ---- */
  .reveal {
    animation: rise 0.6s cubic-bezier(0.22, 0.8, 0.3, 1) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal { animation: none; }
  }

  /* ---- hero ---- */
  .hero {
    padding: clamp(2.5rem, 9vw, 5.5rem) 0 clamp(2rem, 5vw, 3rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 16rem);
    grid-template-areas:
      'eyebrow  eyebrow'
      'name     portrait'
      'intro    portrait';
    column-gap: clamp(1.5rem, 5vw, 3.5rem);
    row-gap: clamp(1.2rem, 3vw, 2rem);
    align-items: end;
  }

  .eyebrow {
    grid-area: eyebrow;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .name {
    grid-area: name;
    font-size: clamp(3.2rem, 12vw, 8.8rem);
    line-height: 0.85;
    font-weight: 300;
    letter-spacing: -0.045em;
    margin: 0;
    color: var(--ink);
  }

  .portrait {
    grid-area: portrait;
    margin: 0;
    align-self: end;
  }
  .portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center 38%;
    border: 1px solid var(--rule);
    filter: saturate(0.92);
  }

  .intro { grid-area: intro; max-width: 44ch; }
  .lede {
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--ink);
    font-weight: 300;
  }
  .intro p + p {
    margin-top: 0.85rem;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.6;
  }

  /* ---- now strip ---- */
  .now {
    display: flex;
    align-items: baseline;
    gap: clamp(1.6rem, 5vw, 3.5rem);
    flex-wrap: wrap;
    margin: 0 0 clamp(2rem, 5vw, 3rem);
    padding: 1rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .now dt {
    font-family: var(--mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .now dd {
    margin: 0.25rem 0 0;
    font-size: 1.02rem;
    color: var(--ink);
  }
  .now-mark { margin-left: auto; color: var(--rule); line-height: 0; align-self: center; }

  /* ---- index ---- */
  .index {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    border-top: 1px solid var(--ink);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.6rem 1.4rem 1.5rem 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    transition: background-color 0.18s ease;
  }
  .card + .card { border-left: 1px solid var(--rule); padding-left: 1.4rem; }
  .card:hover { background: var(--accent-soft); }

  .card-label {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .card-stat {
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    line-height: 1;
    font-weight: 300;
    color: var(--ink);
    letter-spacing: -0.025em;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .card-unit {
    font-family: var(--mono);
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .card-line {
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 26ch;
  }
  .card-go {
    font-family: var(--mono);
    font-size: 0.9rem;
    color: var(--accent);
    margin-top: auto;
    padding-top: 0.8rem;
    transition: transform 0.18s ease;
  }
  .card:hover .card-go { transform: translateX(4px); }
  @media (prefers-reduced-motion: reduce) {
    .card, .card-go { transition: none; }
    .card:hover .card-go { transform: none; }
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      grid-template-areas: 'eyebrow' 'name' 'portrait' 'intro';
      align-items: start;
    }
    .portrait { max-width: 11rem; }
    .card + .card { border-left: none; padding-left: 0; }
    .now-mark { display: none; }
  }
</style>
