---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Monogram from '../components/Monogram.astro';
import TripMap from '../components/TripMap.astro';
import ConfigSync from '../components/diagrams/ConfigSync.astro';
import portrait from '../assets/profile.jpg';
import weddingPhoto from '../assets/wedding/hero.jpg';
import { places, trips } from '../data/travel';
import { stats as gameStats, hero as topGame } from '../data/gaming';
import { systems } from '../data/career';
import { chinese, japanese } from '../data/anime';
import { contact } from '../data/contact';

// Every figure is derived from the data the pages themselves render, so the
// front page cannot drift out of step with what it links to.
const animeCount = chinese.length + japanese.length;
const nextTrip = trips.find((t) => t.status === 'ahead');

const WEDDING = '2026-11-21';
const daysTo = Math.max(
  0,
  Math.round((Date.parse(WEDDING) - Date.parse(new Date().toISOString().slice(0, 10))) / 86400000),
);

const now = [
  { k: 'Wedding', v: `${daysTo} days`, id: 'wed-count' },
  { k: 'Next trip', v: nextTrip ? `${nextTrip.place}, ${nextTrip.when.replace(/^Late /, '')}` : '—' },
  { k: 'Home since', v: 'July 2026' },
];

// Each card previews its page with that page's own material rather than a
// count alone: a piece of a career diagram, the travel map, the gaming split,
// the top of the anime rankings, the wedding photograph.
const gamingSplit = [
  { name: topGame.game, hours: topGame.hours },
  { name: 'Everything else', hours: gameStats.hours - topGame.hours },
].map((g) => ({ ...g, pct: Math.round((g.hours / gameStats.hours) * 100) }));

const topAnime = [
  { ...japanese[0], tag: 'JP' },
  { ...japanese[1], tag: 'JP' },
  { ...chinese[0], tag: 'CN' },
  { ...chinese[1], tag: 'CN' },
];

const sections = [
  { key: 'career',  href: '/career/',  label: 'Career',  stat: '10 yrs', unit: 'at Amazon',
    line: `Ten years of platforms. ${systems.length} systems, drawn rather than described.` },
  { key: 'travel',  href: '/travel/',  label: 'Travel',  stat: String(places.length), unit: 'places',
    line: 'India and the United States, and what is still ahead.' },
  { key: 'gaming',  href: '/gaming/',  label: 'Gaming',  stat: Math.round(gameStats.hours).toLocaleString('en-US'), unit: 'hours',
    line: 'Thirteen years on Steam, and one game with most of them.' },
  { key: 'anime',   href: '/anime/',   label: 'Anime',   stat: String(animeCount), unit: 'ranked',
    line: 'Chinese and Japanese, ten of each, by world rating.' },
  { key: 'wedding', href: '/wedding/', label: 'Wedding', stat: '21 Nov', unit: '2026',
    line: 'Schedule, venue, and how to get there.' },
];
---

<Base
  title="Lucky Sahani"
  description="Engineer in Gurgaon. Ten years at Amazon, most of them in Seattle. Lists of games, places and anime, and the work behind them."
  bare
>
  <div class="home">
    <section class="hero">
      <div class="hero-main">
        <p class="eyebrow reveal" style="--d:0ms">Gurgaon, India</p>

        <h1 class="name reveal" style="--d:60ms">Lucky<br />Sahani</h1>

        <div class="intro reveal" style="--d:140ms">
          <p class="lede">
            Engineer. Ten years at Amazon, most of them in Seattle — home again
            now, and getting married in November.
          </p>
          <p>
            I keep lists. Games I fully intend to get to, places I have been,
            anime I am several seasons behind on. This site is mostly those
            lists, and the work that paid for them.
          </p>
          <p class="reach">
            {contact.map((c) => <a href={c.href} rel={c.rel}>{c.label}</a>)}
          </p>
        </div>
      </div>

      <div class="hero-side reveal" style="--d:220ms">
        <figure class="portrait">
          <Image src={portrait} alt="Lucky Sahani on a trek, in front of a waterfall"
                 widths={[320, 520, 720]} sizes="(max-width: 820px) 9rem, 15rem" loading="eager" />
        </figure>

        <dl class="now">
          {now.map((n) => (
            <div>
              <dt>{n.k}</dt>
              <dd id={n.id}>{n.v}</dd>
            </div>
          ))}
          <div class="now-mark" aria-hidden="true"><Monogram size={18} /></div>
        </dl>
      </div>
    </section>

    <nav class="index" aria-label="Sections">
      {sections.map((s, i) => (
        <a class="card reveal" style={`--d:${300 + i * 60}ms`} href={s.href}>
          <span class="card-label">{s.label}</span>

          <span class={`card-art card-art--${s.key}`} aria-hidden="true">
            {s.key === 'career' && <span class="art-diagram"><ConfigSync /></span>}
            {s.key === 'travel' && <TripMap places={places} compact />}
            {s.key === 'gaming' && (
              <span class="art-split">
                {gamingSplit.map((g) => (
                  <span class="split-row">
                    <span class="split-head"><span class="split-name">{g.name}</span><span class="tabular">{g.pct}%</span></span>
                    <span class="split-bar"><span style={`width:${g.pct}%`}></span></span>
                  </span>
                ))}
              </span>
            )}
            {s.key === 'anime' && (
              <span class="art-rank">
                {topAnime.map((a) => (
                  <span class="rank-row">
                    <span class="rank-score tabular">{a.score.toFixed(2)}</span>
                    <span class="rank-name">{a.name}</span>
                    <span class="rank-tag">{a.tag}</span>
                  </span>
                ))}
              </span>
            )}
            {s.key === 'wedding' && (
              <Image src={weddingPhoto} alt="" widths={[320, 640]}
                     sizes="(max-width: 640px) 92vw, (max-width: 1100px) 46vw, 16rem" />
            )}
          </span>

          <span class="card-stat tabular">
            {s.stat}<span class="card-unit">{s.unit}</span>
          </span>
          <span class="card-line">{s.line}</span>
          <span class="card-go" aria-hidden="true">→</span>
        </a>
      ))}
    </nav>
  </div>
</Base>

<script is:inline define:vars={{ WEDDING }}>
  // Rendered server-side too, so this only corrects for days elapsed since
  // the last build rather than being the only source of the number.
  (function () {
    var el = document.getElementById('wed-count');
    if (!el) return;
    var today = new Date();
    var d = Math.round(
      (Date.parse(WEDDING) - Date.parse(today.toISOString().slice(0, 10))) / 86400000,
    );
    if (d > 0) el.textContent = d + ' days';
    else if (d === 0) el.textContent = 'today';
    else el.textContent = 'married';
  })();
</script>

<style>
  .home { max-width: 78rem; margin: 0 auto; padding: 0 1.5rem 2.5rem; }

  /* ---- entrance ---- */
  .reveal {
    animation: rise 0.6s cubic-bezier(0.22, 0.8, 0.3, 1) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal { animation: none; }
  }

  /* ---- hero ----
     Sized so the section cards clear the fold on a 1440 x 900 screen: the
     portrait and the now list share a column beside the name instead of
     stacking beneath it. */
  .hero {
    padding: clamp(2rem, 5vw, 3.25rem) 0 clamp(2rem, 4vw, 2.75rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 15rem);
    column-gap: clamp(1.5rem, 6vw, 5rem);
    align-items: start;
  }
  .hero-main {
    display: grid;
    gap: clamp(1rem, 2.2vw, 1.5rem);
    align-content: start;
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .name {
    font-size: clamp(3.2rem, 9.5vw, 6.9rem);
    line-height: 0.85;
    font-weight: 300;
    letter-spacing: -0.045em;
    margin: 0;
    color: var(--ink);
  }

  .intro { max-width: 46ch; }
  .lede {
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--ink);
    font-weight: 300;
  }
  .intro p + p {
    margin-top: 0.85rem;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.6;
  }
  .intro .reach {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.3rem;
    margin-top: 1.1rem;
  }
  .reach a {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-soft);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.15rem;
  }
  .reach a:hover { color: var(--ink); border-bottom-color: var(--accent); }

  .portrait { margin: 0; }
  .portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center 38%;
    border: 1px solid var(--rule);
    filter: saturate(0.92);
  }

  /* ---- now ---- */
  .now {
    display: grid;
    gap: 0.75rem;
    margin: 1.1rem 0 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule);
  }
  .now dt {
    font-family: var(--mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .now dd {
    margin: 0.2rem 0 0;
    font-size: 0.98rem;
    color: var(--ink);
  }
  .now-mark { color: var(--rule); line-height: 0; justify-self: end; margin-top: -1.6rem; }

  /* ---- index ----
     Hairlines come from the grid gap showing the rule colour through, so
     they fall correctly at every column count. Five columns on a wide
     screen, three over two on a tablet, one on a phone — never a card
     alone in a row. The negative inline margin lines card text up with the
     hero above. */
  .index {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    background: var(--rule);
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    margin-inline: -1.2rem;
  }
  @media (min-width: 640px) {
    .index { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .card { grid-column: span 2; }
    .card:nth-child(n + 4) { grid-column: span 3; }
  }
  @media (min-width: 1100px) {
    .index { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .card, .card:nth-child(n + 4) { grid-column: auto; }
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.3rem 1.2rem 1.2rem;
    background: var(--paper);
    text-decoration: none;
    transition: background-color 0.18s ease;
    min-width: 0;
  }
  .card:hover { background: var(--accent-soft); }

  .card-label {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  /* ---- previews ---- */
  .card-art {
    display: block;
    position: relative;
    height: 6.5rem;
    margin: 0.25rem 0 0.5rem;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--rule-soft);
  }
  .card:hover .card-art { border-color: var(--rule); }

  /* A crop of the first stages of the config-sync diagram, large enough that
     its boxes and arrows still read as a diagram. */
  .art-diagram { position: absolute; inset: 0; }
  .art-diagram :global(.dg) {
    min-width: 0;
    max-width: none; /* the global reset caps svg at its container */
    width: 150%;
    margin: -0.55rem 0 0 -0.1rem;
  }

  .card-art--travel { padding: 0.45rem 0.5rem; }
  .card-art--travel :global(.tmap-svg--mini) { width: 100%; }

  .art-split,
  .art-rank {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    padding: 0.6rem 0.75rem;
  }
  .art-split { gap: 0.75rem; }
  .split-head {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-family: var(--mono);
    font-size: 0.6rem;
    color: var(--ink-soft);
  }
  .split-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .split-bar {
    display: block;
    height: 6px;
    margin-top: 0.3rem;
    background: var(--rule-soft);
    border-radius: 2px;
    overflow: hidden;
  }
  .split-bar > span {
    display: block;
    height: 100%;
    background: var(--accent);
    border-radius: 0 3px 3px 0;
  }

  .art-rank { gap: 0.3rem; }
  .rank-row {
    display: grid;
    grid-template-columns: 2.3rem minmax(0, 1fr) auto;
    gap: 0.5rem;
    align-items: baseline;
  }
  .rank-score { font-family: var(--mono); font-size: 0.64rem; color: var(--accent); }
  .rank-name {
    font-size: 0.8rem;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .rank-tag { font-family: var(--mono); font-size: 0.52rem; letter-spacing: 0.1em; color: var(--ink-faint); }

  .card-art--wedding :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }

  .card-stat {
    font-size: clamp(1.7rem, 2.8vw, 2.2rem);
    line-height: 1;
    font-weight: 300;
    color: var(--ink);
    letter-spacing: -0.025em;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .card-unit {
    font-family: var(--mono);
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .card-line {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 30ch;
  }
  .card-go {
    font-family: var(--mono);
    font-size: 0.9rem;
    color: var(--accent);
    margin-top: auto;
    padding-top: 0.6rem;
    transition: transform 0.18s ease;
  }
  .card:hover .card-go { transform: translateX(4px); }
  @media (prefers-reduced-motion: reduce) {
    .card, .card-go { transition: none; }
    .card:hover .card-go { transform: none; }
  }

  @media (max-width: 820px) {
    .hero { grid-template-columns: minmax(0, 1fr); row-gap: 1.8rem; }
    .hero-side {
      display: grid;
      grid-template-columns: 8.5rem minmax(0, 1fr);
      gap: 1.25rem;
      align-items: start;
    }
    .now { margin: 0; padding-top: 0; border-top: none; }
    .now-mark { display: none; }
    .card-art { height: 7.5rem; }
  }
</style>
