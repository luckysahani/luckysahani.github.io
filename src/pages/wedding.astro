---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import hero from '../assets/wedding/hero.jpg';
import { couple, headline, events, venue, faqs, rsvp } from '../data/wedding';

// Group events by the day they fall on, preserving order.
const days: { key: string; day: string; date: string; items: typeof events }[] = [];
for (const e of events) {
  const key = `${e.day} ${e.date}`;
  const found = days.find((d) => d.key === key);
  if (found) found.items.push(e);
  else days.push({ key, day: e.day, date: e.date, items: [e] });
}

// The invite travels on WhatsApp, so the link has to unfurl with the
// names and the photograph. JPEG rather than WebP for the widest
// compatibility across chat clients.
const ogImage = await getImage({
  src: hero,
  width: 1200,
  height: 630,
  fit: 'cover',
  position: 'center',
  format: 'jpeg',
});

const names =
  couple.nameOne && couple.nameTwo
    ? `${couple.nameOne} & ${couple.nameTwo}`
    : 'Our wedding';
---

<Base
  title="Wedding"
  description={`${names} — ${headline.date}, ${headline.place}. Schedule, travel and everything you need to know.`}
  ogImage={ogImage.src}
  noindex
>
  <div class="wed">
    <section class="hero u-full">
      <div class="hero-media">
        <Image
          src={hero}
          alt="The couple at the Kishangarh marble grounds during their pre-wedding shoot"
          widths={[600, 900, 1400, 2000]}
          sizes="(max-width: 900px) 100vw, 55vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="hero-text">
        <p class="wed-kicker">We're getting married</p>
        <h1 class="hero-names">
          {couple.nameOne ?? <span class="slot">Name</span>}
          <span class="amp">&amp;</span>
          {couple.nameTwo ?? <span class="slot">Name</span>}
        </h1>
        <p class="hero-date">{headline.shortDate}</p>
        <p class="hero-where">{headline.date}<br />{headline.place}</p>
        {couple.hashtag
          ? <p class="hero-tag">{couple.hashtag}</p>
          : <p class="hero-tag"><span class="slot">#hashtag</span></p>}
      </div>
    </section>

    <article class="prose wed-body">
      <p class="wed-intro">
        Two days of it, one venue, everyone in the same place. Below is
        everything you need — when things start, where to be, and the handful
        of practical details worth knowing before you set off.
      </p>

      <hr class="rule-line" />

      <section class="u-wide">
        <p class="label">The celebration</p>
        <ol class="schedule">
          {days.map((d) => (
            <li class="sched-day">
              <div class="sched-when">
                <span class="sched-date">{d.date}</span>
                <span class="sched-dow">{d.day}</span>
              </div>
              <ul class="sched-items">
                {d.items.map((e) => (
                  <li class="sched-item">
                    <h3 class="ev-name">{e.name}</h3>
                    <p class="ev-meta">
                      {e.time ? <span class="ev-time">{e.time}</span>
                              : <span class="slot slot-sm">time</span>}
                      <span class="ev-venue">{e.venue}</span>
                    </p>
                    {e.note && <p class="ev-note">{e.note}</p>}
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </section>

      <hr class="rule-line" />

      <section>
        <p class="label">Getting there</p>
        <h2 class="sec-title">{venue.name}</h2>
        <p class="venue-aka">also signposted as {venue.alsoKnownAs}</p>
        <p class="venue-addr">{venue.address}</p>
        <p class="venue-line">{venue.fromAirport}. {venue.grounds}.</p>
        <p class="venue-line">
          Rooms open at <strong>{venue.checkIn}</strong>, check-out is
          <strong> {venue.checkOut}</strong>.
        </p>
        <p class="cta-row">
          <a class="btn" href={venue.mapsUrl} target="_blank" rel="noopener">
            Open in Maps
          </a>
        </p>
      </section>

      <hr class="rule-line" />

      <section>
        <p class="label">Worth knowing</p>
        <dl class="faq">
          {faqs.map((f) => (
            <div class="faq-item">
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))}
        </dl>
      </section>

      <hr class="rule-line" />

      <section class="rsvp">
        <p class="label">RSVP</p>
        {rsvp.url ? (
          <>
            <p>Let us know if you can make it, and for which nights.</p>
            <p class="cta-row"><a class="btn btn-solid" href={rsvp.url}>Reply</a></p>
          </>
        ) : (
          <p class="wed-muted">
            The RSVP form goes here once it is set up — accept or decline, a
            headcount, and which of the two nights you are staying.
          </p>
        )}
      </section>

      <section class="gallery-note">
        <p class="label">Photographs</p>
        <p class="wed-muted">
          More from the shoot will go here — a gallery sits naturally below
          this line.
        </p>
      </section>
    </article>
  </div>
</Base>

<style>
  /* A warmer accent than the site default, drawn from the photograph.
     Scoped to this page only. */
  .wed {
    --wed: #A3323F;
    --wed-soft: #F4E6E7;
  }
  :global(:root[data-theme='dark']) .wed,
  :global(:root:not([data-theme='light'])) .wed {
    --wed: #E08A92;
    --wed-soft: #2C1A1C;
  }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .wed {
      --wed: #A3323F;
      --wed-soft: #F4E6E7;
    }
  }

  /* ---- hero ---- */

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    min-height: min(84vh, 760px);
  }

  .hero-media {
    overflow: hidden;
    background: var(--surface-2, var(--rule-soft));
  }
  .hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
    display: block;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 5vw, 4.5rem);
    gap: 0.9rem;
  }

  .wed-kicker {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--wed);
  }

  .hero-names {
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: 0;
  }
  .amp {
    font-style: italic;
    color: var(--wed);
    padding: 0 0.15em;
  }

  .hero-date {
    font-family: var(--mono);
    font-size: 0.95rem;
    letter-spacing: 0.22em;
    color: var(--ink-soft);
    margin-top: 0.3rem;
  }

  .hero-where {
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .hero-tag {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--wed);
    margin-top: 0.4rem;
  }

  /* ---- placeholder slots ---- */

  .slot {
    display: inline-block;
    color: var(--ink-faint);
    border-bottom: 1.5px dashed var(--ink-faint);
    font-style: italic;
    opacity: 0.75;
  }
  .slot-sm {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-style: normal;
  }

  /* ---- body ---- */

  .wed-body {
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 0;
  }

  .wed-intro {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-soft);
    font-style: italic;
    font-weight: 300;
  }

  .sec-title {
    font-size: var(--step-2);
    margin-top: 0.35rem;
  }

  /* ---- schedule ---- */

  .schedule {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .sched-day {
    display: grid;
    grid-template-columns: minmax(0, 8.5rem) 1fr;
    gap: 1.75rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--rule);
  }
  .sched-day:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .sched-when {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-top: 0.2rem;
  }
  .sched-date {
    font-size: 1.15rem;
    color: var(--ink);
    line-height: 1.2;
  }
  .sched-dow {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .sched-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .ev-name {
    font-size: var(--step-1);
    font-weight: 400;
    margin: 0;
    line-height: 1.2;
  }

  .ev-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem;
    margin-top: 0.35rem;
  }
  .ev-time {
    font-family: var(--mono);
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    color: var(--wed);
    background: var(--wed-soft);
    padding: 0.15rem 0.45rem;
  }
  .ev-venue {
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .ev-note {
    font-size: 0.95rem;
    color: var(--ink-faint);
    margin-top: 0.35rem;
    font-style: italic;
    max-width: 46ch;
  }

  /* ---- venue ---- */

  .venue-aka {
    font-size: 0.95rem;
    color: var(--ink-faint);
    font-style: italic;
  }
  .venue-addr {
    margin-top: 0.75rem;
    color: var(--ink-soft);
  }
  .venue-line {
    margin-top: 0.6rem;
    color: var(--ink-soft);
  }

  .cta-row {
    margin-top: 1.4rem;
  }

  .btn {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--wed);
    border: 1px solid var(--wed);
    padding: 0.6rem 1.1rem;
  }
  .btn:hover {
    background: var(--wed-soft);
    color: var(--wed);
  }
  .btn-solid {
    background: var(--wed);
    color: var(--paper);
  }
  .btn-solid:hover {
    opacity: 0.88;
    background: var(--wed);
    color: var(--paper);
  }

  /* ---- faq ---- */

  .faq {
    margin: 1.1rem 0 0;
  }
  .faq-item {
    padding: 1.1rem 0;
    border-top: 1px solid var(--rule-soft);
  }
  .faq-item:last-child {
    border-bottom: 1px solid var(--rule-soft);
  }
  .faq dt {
    font-size: 1.08rem;
    color: var(--ink);
    line-height: 1.35;
  }
  .faq dd {
    margin: 0.4rem 0 0;
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .wed-muted {
    color: var(--ink-faint);
    font-style: italic;
  }

  .rsvp,
  .gallery-note {
    padding-top: 0.4rem;
  }

  /* ---- responsive ---- */

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    /* Generous, but the names still have to clear the fold on a phone.
       A fixed height rather than aspect-ratio — the latter derives width
       from the capped height and leaves the container short of full bleed. */
    .hero-media {
      width: 100%;
      height: 46vh;
    }
    .hero-text {
      padding: 2rem 1.5rem 2.5rem;
    }
  }

  @media (max-width: 620px) {
    .sched-day {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
    .sched-when {
      flex-direction: row;
      align-items: baseline;
      gap: 0.6rem;
    }
  }
</style>
