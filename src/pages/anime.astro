---
import Base from '../layouts/Base.astro';
import { thesis, chinese, japanese, note } from '../data/anime';

const sections = [
  { key: 'cn', title: 'Chinese', sub: 'Donghua', rows: chinese,
    lede: 'Cultivation epics, mostly, and long runs — often hundreds of episodes. The rating pools here are much smaller than on the Japanese side.' },
  { key: 'jp', title: 'Japanese', sub: 'Anime', rows: japanese,
    lede: 'The canon, more or less. Nothing here is rated by fewer than a few hundred thousand people.' },
];

const maxRaters = Math.max(...[...chinese, ...japanese].map((r) => r.raters));
---

<Base
  title="Anime"
  description="The ten best-regarded Chinese and Japanese series from my list, ordered by MyAnimeList rating."
>
  <article class="prose anime">
    <p class="kicker">{thesis.kicker}</p>
    <h1>{thesis.headline}</h1>
    <p class="dek">{thesis.dek}</p>

    {sections.map((s) => (
      <>
        <hr class="rule-line" />
        <section class="u-wide">
          <div class="sec-head">
            <h2>{s.title}</h2>
            <span class="sec-sub">{s.sub}</span>
          </div>
          <p class="sec-lede">{s.lede}</p>
          <ol class="rank">
            {s.rows.map((r) => (
              <li class="rk">
                <span class="rk-n tabular">{String(r.rank).padStart(2, '0')}</span>
                <span class="rk-body">
                  <span class="rk-name">{r.name}</span>
                  {r.mal !== r.name && <span class="rk-mal">{r.mal}</span>}
                </span>
                <span class="rk-year tabular">{r.year}</span>
                <span class="rk-score tabular">{r.score.toFixed(2)}</span>
                <span class="rk-votes">
                  <span class="rk-votebar">
                    <span class="rk-votefill" style={`width:${Math.max(2, (r.raters / maxRaters) * 100)}%`}></span>
                  </span>
                  <span class="rk-voten tabular">
                    {r.raters >= 1000 ? `${Math.round(r.raters / 1000)}k` : r.raters}
                  </span>
                </span>
              </li>
            ))}
          </ol>
        </section>
      </>
    ))}

    <hr class="rule-line" />

    <section>
      <p class="label">On the numbers</p>
      <p class="note">{note}</p>
    </section>
  </article>
</Base>

<style>
  .anime { padding: clamp(3rem, 8vw, 5rem) 0 0; }

  .sec-head {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
  }
  .sec-head h2 { font-size: var(--step-2); margin: 0; }
  .sec-sub {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .sec-lede {
    color: var(--ink-soft);
    max-width: 62ch;
    margin-top: 0.4rem;
    font-size: 0.98rem;
  }

  .rank { list-style: none; margin: 1.3rem 0 0; padding: 0; }

  .rk {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr) 3.2rem 3.2rem 6.5rem;
    gap: 1rem;
    align-items: center;
    padding: 0.62rem 0;
    border-top: 1px solid var(--rule-soft);
  }
  .rk:last-child { border-bottom: 1px solid var(--rule-soft); }

  .rk-n {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--ink-faint);
  }
  .rk-body { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .rk-name {
    font-size: 1.02rem;
    color: var(--ink);
    line-height: 1.25;
  }
  .rk-mal {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
  }
  .rk-year {
    font-family: var(--mono);
    font-size: 0.66rem;
    color: var(--ink-faint);
  }
  .rk-score {
    font-size: 1.06rem;
    color: var(--accent);
    text-align: right;
  }
  .rk-votes { display: flex; align-items: center; gap: 0.45rem; }
  .rk-votebar {
    flex: 1;
    height: 5px;
    background: var(--rule-soft);
    border-radius: 2px;
    overflow: hidden;
  }
  .rk-votefill {
    display: block;
    height: 100%;
    background: var(--ink-faint);
    border-radius: 0 3px 3px 0;
  }
  .rk-voten {
    font-family: var(--mono);
    font-size: 0.6rem;
    color: var(--ink-faint);
    width: 2.4rem;
    text-align: right;
  }

  .note {
    color: var(--ink-soft);
    max-width: 62ch;
    font-size: 0.96rem;
  }

  @media (max-width: 720px) {
    .rk {
      grid-template-columns: 1.8rem minmax(0, 1fr) 3rem;
      gap: 0.5rem 0.8rem;
    }
    .rk-year { display: none; }
    .rk-votes { grid-column: 2 / -1; }
    .rk-votebar { max-width: 8rem; }
  }
</style>
