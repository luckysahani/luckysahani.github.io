---
import { Image } from 'astro:assets';
import ask from '../assets/wedding/gallery/01-proposal-ask.jpg';
import yes from '../assets/wedding/gallery/02-proposal-yes.jpg';
import four from '../assets/wedding/gallery/03-kishangarh-four.jpg';
import steps from '../assets/wedding/gallery/04-patrika-steps.jpg';
import colonnade from '../assets/wedding/gallery/05-patrika-colonnade.jpg';
import gardens from '../assets/wedding/gallery/06-amer-gardens.jpg';
import window_ from '../assets/wedding/gallery/07-amer-window.jpg';

// The first two run in sequence, so they sit side by side and lead.
const shots = [
  { src: ask,       alt: 'The proposal at the Kishangarh marble flats, ring held out at sunset', cap: 'Kishangarh, at sunset', wide: false },
  { src: yes,       alt: 'The proposal a moment later, hand taken',                              cap: 'A moment later',        wide: false },
  { src: four,      alt: 'The four of us on the marble flats at dusk',                           cap: 'The four of us',        wide: true  },
  { src: steps,     alt: 'The two of us on the steps at Patrika Gate, Jaipur',                   cap: 'Patrika Gate',          wide: false },
  { src: colonnade, alt: 'Kanchan in the painted colonnade at Patrika Gate',                     cap: 'Patrika Gate',          wide: false },
  { src: gardens,   alt: 'Kanchan in the gardens below Amer Fort',                               cap: 'Amer Fort',             wide: false },
  { src: window_,   alt: 'Kanchan at a latticed window inside Amer Fort',                        cap: 'Amer Fort',             wide: false },
];
---

<div class="gal">
  {shots.map((s, i) => (
    <figure class={s.wide ? 'gal-item gal-item--wide' : 'gal-item'}>
      <Image
        src={s.src}
        alt={s.alt}
        widths={[420, 700, 1100]}
        sizes="(max-width: 640px) 92vw, (max-width: 1000px) 46vw, 30vw"
        loading={i < 2 ? 'eager' : 'lazy'}
      />
      <figcaption>{s.cap}</figcaption>
    </figure>
  ))}
</div>

<style>
  .gal {
    margin-top: 1.1rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.8rem;
    /* The two-column item cannot fit beside the first pair, so without
       dense packing it wraps and leaves a hole in the top-right. */
    grid-auto-flow: dense;
  }
  .gal-item { margin: 0; }
  .gal-item--wide { grid-column: span 2; }

  .gal-item :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    background: var(--surface-2, var(--rule-soft));
  }
  .gal-item--wide :global(img) { aspect-ratio: 3 / 2; }

  figcaption {
    margin-top: 0.4rem;
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  @media (max-width: 640px) {
    .gal { grid-template-columns: 1fr 1fr; }
    .gal-item--wide { grid-column: span 2; }
  }
</style>
