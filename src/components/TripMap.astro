---
import type { Place } from '../data/travel';

interface Props {
  places: Place[];
}

const { places } = Astro.props;

/**
 * Equirectangular projection matching the frame the coastline was generated
 * in: longitude -170..100, latitude 70..-5 — Alaska through South Asia.
 *
 * Static SVG rather than a tile map. Forty pins do not justify megabytes of
 * vector tiles, and this themes correctly and works offline. Pins carry no
 * labels: at this density they collide, so the list below does the naming.
 *
 * Coastline: Natural Earth 110m land via world-atlas, public domain.
 */
const K = 1000 / 270;
const pins = places.map((p) => ({
  status: p.status,
  title: `${p.name} — ${p.when}`,
  x: (p.coords[0] + 180) * K,
  y: (90 - p.coords[1]) * K,
}));
