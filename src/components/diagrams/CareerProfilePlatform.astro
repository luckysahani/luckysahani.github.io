---
/** Career-profile platform — GraphQL gateway, data layer, event fan-out. */
---
<svg class="dg" viewBox="0 0 760 336" role="img"
     aria-label="Web and mobile clients query an AppSync GraphQL API, whose resolvers call a Lambda backed by a single-table DynamoDB; a batch path ingests from S3, and DynamoDB Streams fan out through SNS to downstream consumers.">
  <rect class="node" x="10" y="30" width="112" height="44"/>
  <text class="lbl" x="66" y="50" text-anchor="middle">Web app</text>
  <text class="sub" x="66" y="64" text-anchor="middle">micro-frontend</text>

  <rect class="node" x="10" y="96" width="112" height="44"/>
  <text class="lbl" x="66" y="116" text-anchor="middle">React Native</text>
  <text class="sub" x="66" y="130" text-anchor="middle">mobile</text>

  <path class="flow" d="M122 52h20v33M122 118h20v-33M142 85h12"/>
  <path class="head" d="M162 85l-8-4v8z"/>

  <rect class="node" x="164" y="44" width="146" height="82"/>
  <text class="lbl" x="237" y="70" text-anchor="middle">AppSync</text>
  <text class="sub" x="237" y="88" text-anchor="middle">GraphQL schema-driven</text>
  <text class="sub" x="237" y="102" text-anchor="middle">pipeline + unit resolvers</text>

  <path class="flow" d="M310 85h34"/>
  <path class="head" d="M352 85l-8-4v8z"/>

  <rect class="node" x="354" y="63" width="132" height="44"/>
  <text class="lbl" x="420" y="83" text-anchor="middle">Lambda</text>
  <text class="sub" x="420" y="97" text-anchor="middle">DGS codegen</text>

  <path class="flow" d="M486 85h32"/>
  <path class="head" d="M526 85l-8-4v8z"/>

  <rect class="node node--key" x="528" y="63" width="150" height="44"/>
  <text class="lbl" x="603" y="83" text-anchor="middle">DynamoDB</text>
  <text class="sub" x="603" y="97" text-anchor="middle">single-table · GSI access</text>

  <!-- batch ingestion joins the same compute -->
  <rect class="node" x="164" y="196" width="146" height="44"/>
  <text class="lbl" x="237" y="216" text-anchor="middle">S3</text>
  <text class="sub" x="237" y="230" text-anchor="middle">periodic batch drop</text>

  <path class="flow" d="M310 218h110v-99"/>
  <path class="head" d="M420 111l-4 8h8z"/>

  <!-- change stream fans out -->
  <path class="flow" d="M603 107v33"/>
  <path class="head" d="M603 148l-4-8h8z"/>
  <rect class="node" x="528" y="150" width="150" height="40"/>
  <text class="lbl" x="603" y="175" text-anchor="middle">DynamoDB Streams</text>

  <path class="flow" d="M603 190v26"/>
  <path class="head" d="M603 224l-4-8h8z"/>
  <rect class="node" x="528" y="226" width="150" height="40"/>
  <text class="lbl" x="603" y="251" text-anchor="middle">SNS fan-out</text>

  <path class="flow" d="M603 266v22"/>
  <path class="head" d="M603 296l-4-8h8z"/>
  <rect class="node" x="528" y="298" width="150" height="30"/>
  <text class="lbl" x="603" y="318" text-anchor="middle">Downstream consumers</text>

  <text class="win" x="237" y="160" text-anchor="middle">14+ countries · 40+ locales</text>
</svg>
